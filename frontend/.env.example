NEXT_PUBLIC_API_URL=http://localhost:8000
# Vercel: set NEXT_PUBLIC_API_URL to an empty value and BACKEND_ORIGIN to the HTTPS API origin.
# BACKEND_ORIGIN=https://your-api.example.com
# DEMO_PROXY_TOKEN=   (server-only Vercel Secret; optional isolated demo gateway)
# NEXT_PUBLIC_UPLOAD_LIMIT_MB=4  (production proxy default; local development default is 15)
