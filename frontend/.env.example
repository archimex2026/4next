NEXT_PUBLIC_API_URL=http://localhost:8000
# Render's combined Docker build sets an empty public API URL and these public metadata values:
# NEXT_PUBLIC_STORAGE_MODE=ephemeral
# NEXT_PUBLIC_UPLOAD_LIMIT_MB=15
# The Render supervisor supplies server-only BACKEND_ORIGIN=http://127.0.0.1:8000.
# Other deployments may use an HTTPS BACKEND_ORIGIN and a server-only DEMO_PROXY_TOKEN.
