# Optional server-side Gemini selection of verified source excerpts. Empty = local extraction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true behind HTTPS before any public deployment.
COOKIE_SECURE=false
# Optional persistent SQLite location; defaults to backend/book2course.db.
# DATABASE_PATH=/app/data/book2course.db
# Optional Unicode font for PDF export (Arial on Windows / DejaVu Sans on Linux auto-detected).
PDF_FONT_PATH=
